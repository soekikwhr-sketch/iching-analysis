  <div class="info-bits-label">← 初爻　　上爻 →</div>
  <div class="info-row"><span>番号</span><span id="ip-num">1</span></div>
  <div class="info-row"><span>陽爻数</span><span id="ip-yang">6</span></div>
  <div class="info-row"><span>10進</span><span id="ip-dec">63</span></div>
  <div class="info-row"><span>クラスタ</span><span id="ip-cluster">—</span></div>
  <div class="info-row"><span>PC1</span><span id="ip-pc1">—</span></div>
  <div class="info-row"><span>PC2</span><span id="ip-pc2">—</span></div>
  <div class="info-row"><span>PC3</span><span id="ip-pc3">—</span></div>
  <hr class="info-sep">
  <div style="font-size:0.6rem;color:var(--dim);margin-bottom:0.2rem;letter-spacing:0.1em">変爻（上爻→初爻）</div>
  <div style="font-size:0.56rem;margin-bottom:0.4rem;display:flex;gap:0.6rem;">
    <span style="color:#f5c518">クラスタ</span>
