  #info-panel.visible{display:block;}
  .info-symbol{font-size:3rem;text-align:center;margin-bottom:0.5rem;line-height:1;}
  .info-name{font-family:'Noto Serif JP',serif;font-size:1rem;color:var(--accent);text-align:center;letter-spacing:0.2em;margin-bottom:0.5rem;}
  .info-trigrams{font-size:0.68rem;text-align:center;color:var(--dim);margin-bottom:0.6rem;}
  .info-bits{font-size:1.1rem;text-align:center;letter-spacing:0.3em;margin-bottom:0.2rem;}
  .info-bits-label{font-size:0.56rem;text-align:center;color:var(--dim);margin-bottom:0.7rem;}
  .info-row{font-size:0.65rem;color:var(--dim);display:flex;justify-content:space-between;margin-bottom:0.3rem;}
  .info-row span:last-child{color:var(--text);}
