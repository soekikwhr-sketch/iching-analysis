<!DOCTYPE <!DOCTYPE html>

<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>易経 六十四卦 — PCA 3D Map</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Noto+Serif+JP:wght@300;400&display=swap');
  :root{--bg:#04050a;--accent:#00ffe0;--accent2:#ff6b35;--accent3:#a855f7;--text:#c8d8e8;--dim:#3a4a5a;--panel:rgba(8,14,24,0.92);}
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--bg);color:var(--text);font-family:'Share Tech Mono',monospace;overflow:hidden;width:100vw;height:100vh;}
  body::after{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.07) 2px,rgba(0,0,0,0.07) 4px);pointer-events:none;z-index:1000;}
  #canvas{position:fixed;inset:0;cursor:grab;}
  #canvas:active{cursor:grabbing;}
  .hud-top{position:fixed;top:0;left:0;right:0;padding:0.8rem 1.4rem;display:flex;justify-content:space-between;align-items:center;z-index:100;background:linear-gradient(to bottom,rgba(4,5,10,0.95),transparent);pointer-events:none;}
  .title-main{font-family:'Noto Serif JP',serif;font-weight:300;font-size:1.1rem;color:var(--accent);letter-spacing:0.3em;text-shadow:0 0 20px rgba(0,255,224,0.4);}
  .title-sub{font-size:0.62rem;color:var(--dim);letter-spacing:0.15em;margin-top:2px;}
  .variance-badges{display:flex;gap:0.8rem;}
  .badge{font-size:0.65rem;padding:0.25rem 0.6rem;border-radius:2px;letter-spacing:0.1em;}
  .badge-x{background:rgba(255,107,53,0.15);border:1px solid var(--accent2);color:var(--accent2);}
  .badge-y{background:rgba(0,255,224,0.1);border:1px solid var(--accent);color:var(--accent);}
  .badge-z{background:rgba(168,85,247,0.12);border:1px solid var(--accent3);color:var(--accent3);}
  #bit-search{position:fixed;top:4rem;left:50%;transform:translateX(-50%);z-index:100;display:flex;align-items:center;gap:0.6rem;background:var(--panel);border:1px solid var(--dim);border-radius:3px;padding:0.4rem 0.9rem;backdrop-filter:blur(8px);}
  #bit-label{font-size:0.6rem;color:var(--dim);letter-spacing:0.1em;white-space:nowrap;}
