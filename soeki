  #bit-result{font-size:0.65rem;color:var(--accent2);min-width:5em;}
  .hud-bottom{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);display:flex;gap:0.6rem;z-index:100;align-items:center;background:var(--panel);border:1px solid var(--dim);border-radius:3px;padding:0.5rem 0.9rem;backdrop-filter:blur(8px);}
  .ctrl-btn{font-family:'Share Tech Mono',monospace;font-size:0.68rem;background:transparent;border:1px solid var(--dim);color:var(--text);padding:0.3rem 0.7rem;cursor:pointer;letter-spacing:0.1em;transition:all 0.2s;border-radius:2px;}
